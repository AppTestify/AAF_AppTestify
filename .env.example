# Postgres (docker-compose default). Use sqlite:///./data/aaf.db for quick local dev without Docker.
# Default direct connection to postgres:
DATABASE_URL=postgresql+psycopg://aaf:aaf@localhost:5432/aaf
# To use PgBouncer in docker-compose (after starting the pgbouncer service):
# DATABASE_URL=postgresql+psycopg://aaf:aaf@pgbouncer:6432/aaf
# DB_USE_NULLPOOL=true
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
JWT_SECRET=replace-with-long-random-secret
APP_ENCRYPTION_KEY=replace-with-long-random-app-encryption-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default organization
SUPERADMIN_EMAIL=superadmin@localhost
SUPERADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme

# Optional: second tenant + admin for local testing (slug `test` by default). Superadmin is always SUPERADMIN_* above.
SEED_TEST_TENANT=true
TEST_TENANT_SLUG=test
TEST_TENANT_NAME=Test organization
TEST_TENANT_ADMIN_EMAIL=testadmin@localhost
TEST_TENANT_ADMIN_PASSWORD=changeme

# Allow visitors to create an organization + admin account from the marketing UI (set false in production if undesired)
PUBLIC_TENANT_SIGNUP_ENABLED=true

CONNECTOR_MODE=sim
TAU_CONSENSUS=0.55
MAX_RAR_LOOPS=2
W_PERF=0.4
W_COST=0.3
W_RISK=0.3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenTelemetry OTLP (optional). Example: https://otel-collector.example.com:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...
# OTEL_SERVICE_NAME=aaf-governance

# Expose GET /metrics (Prometheus text) without auth — never enable in production
METRICS_PUBLIC_ENABLED=false

# Live GitHub
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Live JIRA
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=PROJ
JIRA_BOARD_ID=1

# Live AWS (FinOps tools)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Live FinOps (JSON or CSV path — fallback when AWS not configured)
FINOPS_COST_FILE=

# RAR live refresh re-fetches stale connector/tool data
RAR_LIVE_REFRESH_ENABLED=false
