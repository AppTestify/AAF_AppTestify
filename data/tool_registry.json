      "function_name": "get_ci_status",
      "agent_id": "devops",
      "method": "api_mcp",
      "implementation_status": "shipped",
      "weight": 0.35,
      "jira_task": "T-072",
      "system": "GitHub Actions",
      "auth": "Bearer token \u2014 repo scope",
      "api_endpoints": [
        "GET /repos/{owner}/{repo}/actions/runs?branch={branch}&per_page=10",
        "GET /repos/{owner}/{repo}/check-runs"
      ],
      "mcp_mappings": [
        "github-mcp \u2192 list_workflow_runs"
      ],
      "fires_when": "Fires first on every release governance run.",
      "returns": [
        "blocking_check",
        "ci_pass_rate",
        "failed_steps",
        "runs_in_window",
        "transport"
      ],
      "pm_scenario": {
        "title": "Should we release v4.12.0 today?",
        "narrative": "CI failing at test step with pass_rate 0.40 raises governance confidence to 0.85+. PM sees 3 of 5 recent CI runs failed \u2014 test step blocking release."
      },
      "id": "devops:get_ci_status",
      "display_agent": "DevOps"
    },
